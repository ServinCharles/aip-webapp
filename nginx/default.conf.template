# Rendered at container start by the nginx image (envsubst replaces ${API_UPSTREAM} only).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Forward API calls to the aip-api microservice (a Kubernetes Service in the same namespace)
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # React single-page app: every other route serves index.html
    location / {
        try_files $uri /index.html;
    }
}
